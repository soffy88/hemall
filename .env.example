# hemall 后端环境变量样例 — 复制为 .env 后按需修改。
# 所有变量前缀 HEMALL_，对应 app/config.py 的 Settings 字段。

# ── 数据库 (PostgreSQL + asyncpg 连接池) ──────────────────────────────
HEMALL_PG_DSN=postgresql://postgres:test@localhost:5432/hemall
HEMALL_PG_POOL_NAME=hemall
HEMALL_PG_POOL_MIN=2
HEMALL_PG_POOL_MAX=10

# ── Redis (结账防超卖分布式锁 / 事件总线) ─────────────────────────────
HEMALL_REDIS_URL=redis://localhost:6379/0

# ── 鉴权 (JWT) ────────────────────────────────────────────────────────
# 生产务必改成随机强密钥。
HEMALL_JWT_SECRET=change-me-in-production
HEMALL_JWT_ALGORITHM=HS256
HEMALL_JWT_EXPIRES_MINUTES=720
# 伪名化盐: user_id → 稳定不可逆引用 (进 omodul fingerprint/trail 前脱敏)
HEMALL_ANON_SALT=hemall-anon-salt

# ── omodul 输出 (decision_trail / report 落盘根目录) ──────────────────
HEMALL_OUTPUT_ROOT=./var/omodul_output

# ── provider 装配 (obase.ProviderRegistry generic category 默认名) ────
HEMALL_DEFAULT_PAYMENT_PROVIDER=manual
HEMALL_DEFAULT_FULFILLMENT_PROVIDER=manual
HEMALL_DEFAULT_SEARCH_PROVIDER=log
HEMALL_DEFAULT_NOTIFICATION_PROVIDER=log
HEMALL_DEFAULT_TAX_PROVIDER=flat_rate
