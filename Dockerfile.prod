# 生产环境 Dockerfile
# 多阶段构建，非 root 运行
#
# 注意：3O 平台包 (obase/oprim/oskill/omodul/oservi) **不需要** sibling 目录。
# pyproject.toml [tool.uv.sources] 已把它们全部钉成固定 git rev，
# `uv sync --frozen` 直接从 git 拉取并安装到 venv。
# 历史上这里有 `--build-context platform3o=../platform/3O` + 10 行
# `COPY --from=platform3o /<pkg> /platform/3O/<pkg>`，属于死拷贝
# （相对路径 sources 早已不存在），却让"runner 上必须存在 ../platform/3O"
# 成为构建硬依赖，CI 与新机器必断。审计 P2-1 已移除。

# ── 构建阶段 ────────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build

# 安装构建依赖
# 注1：容器 IPv6 网络不可用，强制 IPv4 避免 apt-get 卡死
# 注2：deb.debian.org 在容器内下载 .deb 会卡住，切换到阿里云镜像源
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    apt-get update -o Acquire::ForceIPv4=true && \
    apt-get install -y --no-install-recommends -o Acquire::ForceIPv4=true \
    gcc \
    git \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv (快速 Python 包管理，支持 [tool.uv.sources])
# 注：ghcr.io/astral-sh/uv 在此服务器不可用，使用构建上下文中预置的 uv 二进制
COPY deploy-tools/uv /bin/uv

# 3O 平台包由 uv sync --frozen 依据 pyproject.toml [tool.uv.sources] 的
# 固定 git rev 安装到 /opt/venv，无需本地拷贝（审计 P2-1）。

# 复制项目元数据和锁文件，确保生产依赖与 CI 使用同一解析结果。
COPY pyproject.toml uv.lock README.md ./
COPY app/ ./app/

# 依赖必须由 uv.lock 固定；Gunicorn 作为镜像入口工具单独固定精确版本。
# UV_HTTP_TIMEOUT 防止网络慢时超时；uv 默认走 IPv4 优先
ENV UV_HTTP_TIMEOUT=600
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
RUN uv sync --frozen --no-dev --extra observability --extra phase2

# ── 生产阶段 ────────────────────────────────────────────────────────────
FROM python:3.12-slim

# 创建非 root 用户
#
# uid/gid 必须**写死**。`useradd -r` 不带 -u 时会挑一个空闲的系统号
# (Debian: 100..999)，具体取到几号取决于基础镜像里已存在的用户 ——
# 换个 python:3.12-slim 的 digest 就可能变。Helm 侧的
# securityContext.runAsUser/runAsGroup 是硬编码数字，两边一旦漂移：
#   pod 以 uid 1000 启动 → gunicorn master 读 conf 里 user="hemall"
#   → 对 worker 调 setgid/setuid → 非 root 下抛 EPERM → CrashLoopBackOff。
# 固定为 10001（远高于 Debian 系统用户区间 100..999，不会和包管理器分配冲突）。
# 刻意不用 ARG 覆盖：charts/hemal 的 securityContext 是硬编码数字，两边
# 一旦漂移就是 CrashLoopBackOff（audit P1-1）。改这里必须同时改那里。
RUN groupadd -g 10001 hemall && \
    useradd -u 10001 -g 10001 -m -d /home/hemall -s /usr/sbin/nologin hemall

# 安装运行时依赖
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    apt-get update -o Acquire::ForceIPv4=true && \
    apt-get install -y --no-install-recommends -o Acquire::ForceIPv4=true \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 从构建阶段复制虚拟环境 (3O 平台包已在 venv 内，源码来自 git rev)
COPY --from=builder /opt/venv /opt/venv

# 设置环境变量
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH=/app

# 设置工作目录
WORKDIR /app

# 复制应用代码
COPY . .

# entrypoint: root 启动修复数据卷属主后降权为 hemall 运行
COPY deploy-tools/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# 修改文件所有权
RUN chown -R hemall:hemall /app

# 注：不设 USER hemall —— entrypoint 需以 root 运行以修复挂载数据卷属主，
# 随后 gunicorn 通过 user/group 配置将 worker 降权为 hemall。

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

# 启动命令 (entrypoint 会 chown 数据卷后以 hemall 运行)
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["gunicorn", "-c", "gunicorn.conf.py", "app.main:app"]
