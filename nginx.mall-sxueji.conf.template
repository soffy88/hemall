# Nginx 配置文件 for mall.sxueji.com (生产环境) —— **模板**, 由
# nginx/nginx-entrypoint.sh 渲染 (审计 P1-7: 证书路径与 server_name 不得写死)
#
# 注入的环境变量 (compose 中均以必填形式声明，缺配置即启动失败):
#   HEMALL_API_SERVER_NAME / HEMALL_SSL_CERT_PATH / HEMALL_SSL_KEY_PATH
# 渲染只替换 HEMALL_ 前缀占位符；nginx 自身的 $host 等变量原样保留。
events {
    worker_connections 1024;
}

http {
    upstream hemall_backend {
        server api:8000;
    }

    # HTTP 重定向到 HTTPS
    server {
        listen 80;
        server_name ${HEMALL_API_SERVER_NAME};
        return 301 https://$host$request_uri;
    }

    # HTTPS 服务器
    server {
        listen 443 ssl http2;
        server_name ${HEMALL_API_SERVER_NAME};

        # SSL 证书: 由 nginx-entrypoint.sh 校验存在且非空后才放行 (audit P1-7)
        ssl_certificate ${HEMALL_SSL_CERT_PATH};
        ssl_certificate_key ${HEMALL_SSL_KEY_PATH};

        # SSL 安全配置
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;

        # 安全头
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-XSS-Protection "1; mode=block" always;

        # 上传文件大小限制
        client_max_body_size 50M;

        location / {
            proxy_pass http://hemall_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # 超时设置
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        # 健康检查端点
        location /health {
            access_log off;
            proxy_pass http://hemall_backend;
        }
    }
}